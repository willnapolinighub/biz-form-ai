{
  "name": "Business Classification Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "business-classify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "business-classify"
    },
    {
      "parameters": {
        "operation": "jsonParse",
        "jsonParseInput": "json",
        "options": {}
      },
      "id": "json-parse",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.functionItem",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "prompt": "You are a business formation expert. Analyze the user's business description and provide:\n1. The appropriate NAICS code (3-digit minimum)\n2. Recommended entity type (LLC, C-Corp, S-Corp, or Sole Prop)\n3. Industry-specific licenses or permits needed\n4. Estimated annual franchise tax liability by state\n\nRespond in JSON format with keys: naics_code, entity_recommendation, required_licenses (array), tax_estimate\n\nBusiness Name: {{$json.business_name}}\nBusiness Description: {{$json.business_description}}",
        "options": {
          "model": "gpt-4"
        }
      },
      "id": "ai-agent",
      "name": "AI Classification Agent",
      "type": "langchain-agent",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "https://api.statesolver.com/availability",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$credentials.stateApiKey}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "{{$json.business_name}}"
            },
            {
              "name": "state",
              "value": "DE"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request",
      "name": "Check Name Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "const classification = $input.first().json.classification;\nconst availability = $input.last().json;\n\nreturn {\n  naics_code: classification.naics_code,\n  entity_recommendation: classification.entity_recommendation,\n  required_licenses: classification.required_licenses,\n  tax_estimate: classification.tax_estimate,\n  is_available: availability.available,\n  reason: availability.reason\n};"
      },
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
